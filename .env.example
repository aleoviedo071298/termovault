# ============================================================
# TermoVault — variables de entorno (ejemplo)
# ============================================================
# Copialo a .env (NO se versiona) y ajustá los valores.
#   cp .env.example .env
# ============================================================

# ─── POSTGRES ────────────────────────────────────────────────
POSTGRES_DB=termovault
POSTGRES_USER=termovault
POSTGRES_PASSWORD=devsecret_cambiar_en_prod
POSTGRES_PORT=5432

# ─── MINIO (S3-compatible para desarrollo local) ────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_cambiar
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=termovault-dev
MINIO_REGION=us-east-1

# ─── ADMINER (UI web para Postgres) ─────────────────────────
ADMINER_PORT=8080

# ─── BACKEND LARAVEL (cuando exista) ────────────────────────
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_KEY=
# DB
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=termovault
DB_USERNAME=termovault
DB_PASSWORD=devsecret_cambiar_en_prod
# S3
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin_cambiar
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=termovault-dev
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# ─── FRONTEND WEB (cuando exista) ───────────────────────────
VITE_API_URL=http://localhost:8000/api
