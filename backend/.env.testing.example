# .env.testing.example
#
# Example environment configuration for running tests locally.
# Copy to .env.testing and configure as needed.
#
# IMPORTANT: This file contains test/dummy values and is safe to commit.
# Never commit files with real credentials, API keys, or secrets.

APP_NAME=Laravel
APP_ENV=testing
APP_KEY=base64:n5Uv5tMqST5mzjDfqD7KnQpL2rFsB9Y4xWzJvDnK1pQ=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Reduce for faster test execution
BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL test database (create with: docker compose up)
DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5433
DB_DATABASE=termovault_test
DB_USERNAME=termovault
DB_PASSWORD=termovault

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Use in-memory cache for tests (no database needed)
CACHE_STORE=array

SECURITY_HEADERS_ENABLED=true
SECURITY_CSP="default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="test@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Dummy AWS credentials for testing (MinIO compatible)
AWS_ACCESS_KEY_ID=testing
AWS_SECRET_ACCESS_KEY=testing
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=testing
AWS_USE_PATH_STYLE_ENDPOINT=false

FILESYSTEMS_LOCAL_BUCKET_NAME=local

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cognito disabled for testing (no AWS required)
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_test
COGNITO_APP_CLIENT_ID=test_client_id
COGNITO_APP_CLIENT_SECRET=test_client_secret
COGNITO_AUTH_REQUIRED=false
COGNITO_JWT_LEEWAY=60

VITE_APP_NAME="${APP_NAME}"
